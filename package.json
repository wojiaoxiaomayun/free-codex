{
  "name": "free-codex",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + Vue desktop shell for ChatGPT with the native Node.js codex-mcp gateway.",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "clean": "rimraf dist dist-electron release",
    "start": "electron .",
    "preview": "vite preview",
    "dist": "npm run build",
    "dist:dir": "npm run typecheck && vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/vue": "^1.31.0",
    "@meesii/codex-mcp": "0.7.3",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.2.0",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vue-tsc": "^2.1.0"
  },
  "build": {
    "appId": "com.freecodex.app",
    "productName": "Free Codex",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    }
  }
}
